<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dark is the first-run default (docs/ui/tokens.md §5.1). Compose owns the final
      colours and flips the status/navigation bar icon appearance per theme.
    -->
    <style name="Theme.HanziFlow" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#15161A</item>
    </style>
</resources>
