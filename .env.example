# Copy this file to .env and fill values from your ElevenLabs account.
ELEVENLABS_API_KEY=

# Voice IDs are no longer stored here. Run `mandarin-course voices sync` once to fetch
# the account's available Mandarin and Vietnamese voices into a local registry file
# (see MANDARIN_COURSE_VOICES_PATH below); `generate` picks a voice per lesson/role from
# that registry deterministically. See docs/lesson_authoring_guidelines.md.

# Optional overrides
ELEVENLABS_MODEL_ID=eleven_v4
MANDARIN_COURSE_CACHE_DIR=cache
MANDARIN_COURSE_OUTPUT_DIR=output
MANDARIN_COURSE_DB_PATH=data/progress.db
# Defaults to <MANDARIN_COURSE_DB_PATH's directory>/voices.json
MANDARIN_COURSE_VOICES_PATH=
