{
  "name": "agent-monitor",
  "displayName": "Agent Monitor",
  "version": "0.1.0",
  "publisher": "local",
  "description": "Live view of worker agent runs started by scripts/agent_run.sh",
  "engines": { "vscode": "^1.80.0" },
  "main": "./extension.js",
  "activationEvents": ["workspaceContains:scripts/agent_run.sh"],
  "contributes": {
    "commands": [
      { "command": "agentMonitor.openRun", "title": "Agent Monitor: Open run…" }
    ]
  }
}
